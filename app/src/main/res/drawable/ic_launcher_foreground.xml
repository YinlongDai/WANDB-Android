<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- A training curve rising to its latest, still-running point. Kept inside
         the 66dp safe zone and optically centred (the fill weighs the bottom). -->
    <!-- Area under the curve, fading out towards the baseline. -->
    <path android:pathData="M31,72 C39,48 51,41.5 70,39.5 L70,78 L31,78 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="40"
                android:endX="54"
                android:endY="70">
                <item android:offset="0" android:color="#38FFC21A" />
                <item android:offset="1" android:color="#00FFC21A" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- The curve, amber deepening to bright gold as it rises. -->
    <path
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M31,72 C39,48 51,41.5 70,39.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="31"
                android:startY="72"
                android:endX="70"
                android:endY="39.5">
                <item android:offset="0" android:color="#FFF29900" />
                <item android:offset="1" android:color="#FFFFCC33" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Live point: soft halo, then a solid dot with a dark rim to lift it off the line. -->
    <path
        android:fillColor="#40FFCC33"
        android:pathData="M70,39.5m-10,0a10,10 0,1 1,20 0a10,10 0,1 1,-20 0" />
    <path
        android:fillColor="#FF1A1C21"
        android:pathData="M70,39.5m-7,0a7,7 0,1 1,14 0a7,7 0,1 1,-14 0" />
    <path
        android:fillColor="#FFFFD34D"
        android:pathData="M70,39.5m-5,0a5,5 0,1 1,10 0a5,5 0,1 1,-10 0" />
</vector>
